#!/bin/sh
# Versioned git hook (core.hooksPath = scripts/git-hooks, wired by npm install),
# so the rule lives in the repository and is reviewable, rather than in an
# unversioned .git/hooks.
#
# Asks the commit-scope guard about the MESSAGE: a rescue commit must carry
# [skip ci] (else its red CI run alerts on a state nobody claimed was finished),
# and a commit that skips CI must say why.
#
# The message is only readable here — git writes it after the pre-commit hook.
#
# It then asks the model-trailer gate about the same message: every commit records
# its AUTHORING MODEL in its Co-Authored-By trailer, and a trailer naming no model
# reads from the outside exactly like the silent degradation the serving-model
# tripwire exists to catch — so it must not reach history at all.
#
# Worktrees share one .git/config, so this hook also runs in a worktree whose
# branch predates a guard. Skip silently there rather than block a commit over
# a script that branch cannot have.
[ -f scripts/commit-scope-guard.mjs ] || exit 0
node scripts/commit-scope-guard.mjs --message "$1" || exit 1

[ -f scripts/model-trailer-gate.mjs ] || exit 0
exec node scripts/model-trailer-gate.mjs --message "$1"
