#!/bin/sh
# Versioned git hook (core.hooksPath = scripts/git-hooks), so the rule lives in
# the repository and is reviewable, rather than in an unversioned .git/hooks.
# Enable once per clone:  git config core.hooksPath scripts/git-hooks
node scripts/commit-scope-guard.mjs || exit 1

# A wired Stop hook that no preflight entry covers reports nothing while it
# still blocks, and takes the unit suite red with it — which the pre-push gate
# then refuses, leaving the branch committed but unpushable (measured
# 20.08.2026). Asked here, that commit is never made in the first place.
#
# Worktrees share one .git/config, so this hook also runs on branches that
# predate the check. Ask the INDEX whether the commit has the wrapper: the
# working tree may have a different deletion or restoration in a partial stage.
# Skip silently only when the commit being made really predates the check.
git cat-file -e ':scripts/guard-registration-guard.mjs' 2>/dev/null || exit 0
exec node scripts/guard-registration-guard.mjs
