# Normalize all text files to LF in the repository AND the working tree.
# This overrides core.autocrlf on Windows, so git never converts line
# endings on checkout/stage — and never warns "LF will be replaced by CRLF".
* text=auto eol=lf

# The review ledger is append-only. Its named driver verifies that both sides
# only appended to the ancestor before it preserves that prefix and orders the
# union of the newly appended JSONL rows.
.claude/mechanism-reviews.jsonl merge=hoaMechanismLedger

# Binary assets: never touch.
*.png binary
