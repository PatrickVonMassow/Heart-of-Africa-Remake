# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Downloaded DEM tile cache of scripts/build-geodata.mjs (reproducible)
scripts/.tile-cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local TTS asset cache of scripts/verify/ttsCache.mjs (re-primed on demand)
.cache/

# Batch coordination state (scripts/batch-lock.mjs): runtime lock + pause marker
.claude/batch-lock.json
.claude/batch-paused
.batch-dashboard.html
.batch-dashboard-archive.html
# The derived queue's prose and order (point 400, delta C) — session state that
# belongs beside the board it renders, not in the source history.
.claude/board-queue.json
# The chat channel's shared SECRET and its runtime state. The secret is what
# stands between a PUBLIC board page and a session with permissions pre-granted,
# so it is never committed — and neither is a topic name derived from it.
.claude/chat-secret
.claude/chat-state.json
# The stage-1 spool, its archived remains, and the spool DIRECTORY that replaced
# it (one file per message plus the consumed archive the replay ledger reads).
# All of it is the user's own words — never repository content.
.claude/chat-spool.jsonl
.claude/chat-spool.jsonl.migrated-*
.claude/chat-spool/
# The message watcher's own runtime state (point 407). Both belong here for the
# same reason .claude/batch-claim.json does — batch-doctor's stash sweeps what
# git does not know about, and each of these has a failure mode when it goes:
# the PIDFILE deleted makes the next launcher tick start a SECOND watcher beside
# the live one, and the RECEIPT deleted makes an answered message read as
# unanswered, so the next session answers the user all over again.
.claude/chat-watcher.json
.claude/chat-watcher.json.tmp-*
.claude/chat-reply-receipt.json
.claude/chat-reply-receipt.json.tmp-*
.claude/dashboard-state.json
.claude/current-focus.json
.claude/focus-check-pending.json
.claude/session-process.json
.claude/tool-activity.json
.claude/wait-prep.json
.claude/render-verify-state.json
.claude/autostart.log
.claude/autostart-last.json
.claude/autostart-authorized.json
.claude/ntfy-topic
.claude/autostart-state.json
.claude/autostart-run.log
.claude/ci-status-guard-state.json
.claude/sessions-seen.json
.claude/session-activity.json
.claude/parallel-alert.json
.claude/doctor-state.json
.claude/doctor.log
.claude/batch-lock.json.tmp-*
.claude/batch-lock.json.reaping
.claude/timestamp-guard-state.json
.claude/batch-boundary.json
.claude/batch-boundary.json.tmp-*
.claude/batch-in-flight.json
.claude/batch-in-flight.json.tmp-*
.claude/batch-claim.json
.claude/batch-claim.json.tmp-*
# Per-branch baseline of the mechanism four-eyes gate — local bookkeeping. The
# ledger it is judged against (.claude/mechanism-reviews.jsonl) IS tracked: a
# review happens on a branch and the gate bites in the session that merges it.
.claude/mechanism-review-baseline.json
# The pre-push gate's memory of the last green unit run (test-file count). Per
# CHECKOUT on purpose: each worktree has its own dependency tree, and a baseline
# shared across them would compare two different worlds.
.claude/pre-push-gate-state.json

# Local GitHub PAT (ci-status-guard.mjs probes this path) — never committed
.secrets/

# Local, non-versioned artefacts (retrospectives, scratch notes) — never on git
/local/

# Personal working material that must not reach the repository (25.07.2026):
# a voice reference recording and the music sources were swept in by commits
# that staged everything. scripts/commit-scope-guard now blocks that class.
/Referenzstimme*.wav
/music/

# Cover/marketing images are working material, not project source (27.07.2026):
# they were swept in by a commit that staged everything (a0c599b) and the README
# serves its picture from the GitHub attachment CDN, not from here.
/cover/
